{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "hina-coaching",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "public"
  },
  // No database_id: the first deploy creates the D1 database and links it.
  // The database keeps its first name even though the Worker was renamed.
  "d1_databases": [
    { "binding": "DB", "database_name": "hina-lessons" }
  ],
  // Text-to-speech for words and sentences (Workers AI), and a place to keep
  // the audio so each text is only made once. The KV namespace is created
  // on the first deploy, like the database.
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "AUDIO" }
  ],
  "vars": {
    "AI_MODEL": "claude-opus-5-5",
    // Voice for the audio (one of Deepgram Aura 2's English voices).
    "VOICE": "thalia"
  },
  // Keeps Workers Logs on, so errors (like a rejected AI request) show in the dashboard.
  "observability": {
    "logs": { "enabled": true }
  }
  // ANTHROPIC_API_KEY, TEACHER_PASSWORD and TEACHER_API_TOKEN are secrets set in the dashboard
  // (see README.md and docs/student-chats.md).
}
